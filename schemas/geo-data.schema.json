          "type": "boolean",
          "description": "True for builder-owned outputs; false for preserved extra files."
        }
      },
      "required": ["path", "bytes", "sha256", "generated"]
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "api_version": {
          "type": "string"
        },
        "dataset_version": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
