        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "checksum_algorithm": {
          "const": "sha256"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestFile"
          }
        }
      },
      "required": [
        "schema_version",
        "api_version",
        "dataset_version",
        "generator_version",
        "generated_at",
        "counts",
        "file_count",
        "checksum_algorithm",
