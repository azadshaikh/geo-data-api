{
  "openapi": "3.1.0",
  "info": {
    "title": "Geo-Data API",
    "version": "v2",
    "description": "Static country, state, and city files. Resource responses use data and meta; discovery, manifest, and build-report files have their own top-level structures."
  },
  "servers": [
    {
      "url": "https://unpkg.com/geo-data-api@2.0.0/dist/api/v2",
      "description": "Example CDN base URL; deployments can use another host."
    }
  ],
  "paths": {
    "/countries.json": {
      "get": {
        "operationId": "getCountries",
        "tags": ["countries"],
        "summary": "List countries",
        "responses": {
          "200": {
            "description": "Generated JSON file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/geo-data.schema.json#/$defs/CountryListResponse"
                }
              }
            }
          },
          "404": {
            "description": "The file does not exist; the static host controls the error response."
          }
        }
      }
    },
    "/countries/{iso2}.json": {
      "get": {
        "operationId": "getCountry",
        "tags": ["countries"],
        "summary": "Get a country",
        "parameters": [
          {
            "name": "iso2",
            "in": "path",
            "required": true,
            "description": "Lowercase two-letter country ISO 3166-1 alpha-2 code.",
            "schema": { "type": "string", "pattern": "^[a-z]{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated JSON file",
            "content": {
              "application/json": {
